// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:     class Foo {
// CHECK-PARSER-NEXT:         fun inFoo()
// CHECK-PARSER-NEXT:         {
// CHECK-PARSER-NEXT:           print("in foo");
// CHECK-PARSER-NEXT:         }
// CHECK-PARSER-LABEL:     class Bar < Foo {
// CHECK-PARSER-NEXT:         fun inBar()
// CHECK-PARSER-NEXT:         {
// CHECK-PARSER-NEXT:           print("in bar");
// CHECK-PARSER-NEXT:         }
// CHECK-PARSER-LABEL:     class Baz < Bar {
// CHECK-PARSER-NEXT:         fun inBaz()
// CHECK-PARSER-NEXT:         {
// CHECK-PARSER-NEXT:           print("in baz");
// CHECK-PARSER-NEXT:         }
// CHECK-PARSER:           var baz = Baz();
// CHECK-PARSER-NEXT:      baz.inFoo();
// CHECK-PARSER-NEXT:      baz.inBar();
// CHECK-PARSER-NEXT:      baz.inBaz();

// CHECK-SEMANTIC-LABEL:   var baz: Baz = Baz();
// CHECK-SEMANTIC-NEXT:    baz.inFoo();
// CHECK-SEMANTIC-NEXT:    baz.inBar();
// CHECK-SEMANTIC-NEXT:    baz.inBaz();

class Foo {
  fun inFoo() {
    print ("in foo");
  }
}

class Bar < Foo {
  fun inBar() {
    print ("in bar");
  }
}

class Baz < Bar {
  fun inBaz() {
    print ("in baz");
  }
}

var baz = Baz();

baz.inFoo(); // expect: in foo
baz.inBar(); // expect: in bar
baz.inBaz(); // expect: in baz
