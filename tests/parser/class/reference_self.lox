// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:         class Foo {
// CHECK-PARSER-NEXT:      fun returnSelf()
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:        return Foo;
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER:         print(Foo().returnSelf());

// CHECK-SEMANTIC:       class Foo {
// CHECK-SEMANTIC-NEXT:    fun returnSelf()
// CHECK-SEMANTIC-NEXT:    {
// CHECK-SEMANTIC-NEXT:      return Foo;
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC:      }
// CHECK-SEMANTIC:      print(Foo().returnSelf());

class Foo {
  fun returnSelf() {
    return Foo;
  }
}

print (Foo().returnSelf()); // expect: Foo
