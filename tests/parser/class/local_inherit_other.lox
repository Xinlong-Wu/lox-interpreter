// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:     class A {
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER-LABEL:     fun f()
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:          class B < A {
// CHECK-PARSER-NEXT:          }
// CHECK-PARSER:               return B;
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER:           print(f());

// CHECK-SEMANTIC-LABEL:   class A {
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC-LABEL:   fun f()
// CHECK-SEMANTIC-NEXT:    {
// CHECK-SEMANTIC-NEXT:      class B < A {
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC:           return B;
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC:         print(f());

class A {}

fun f() {
  class B < A {}
  return B;
}

print (f()); // expect: B
