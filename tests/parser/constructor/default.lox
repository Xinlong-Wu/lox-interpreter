// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:           class Foo {
// CHECK-PARSER:           }
// CHECK-PARSER:           var foo = Foo();
// CHECK-PARSER:           print(foo);

// CHECK-SEMANTIC:         class Foo {
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC:         var foo: Instance of Foo = Foo();
// CHECK-SEMANTIC-NEXT:    print(foo);

class Foo {}

var foo = Foo();
print (foo); // expect: Foo instance
