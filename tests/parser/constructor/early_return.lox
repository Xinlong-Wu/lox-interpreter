// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:         class Foo {
// CHECK-PARSER-NEXT:      fun init()
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:           print("init");
// CHECK-PARSER-NEXT:           return;
// CHECK-PARSER-NEXT:           print("nope");
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER-NEXT:    }
// CHECK-PARSER:         var foo = Foo();
// CHECK-PARSER-NEXT:    print(foo);

// CHECK-SEMANTIC:       class Foo {
// CHECK-SEMANTIC-NEXT:    fun init()
// CHECK-SEMANTIC-NEXT:    {
// CHECK-SEMANTIC-NEXT:         print("init");
// CHECK-SEMANTIC-NEXT:         return;
// CHECK-SEMANTIC-NEXT:         print("nope");
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC-NEXT:  }
// CHECK-SEMANTIC:       var foo: Instance of Foo = Foo();
// CHECK-SEMANTIC-NEXT:  print(foo);

class Foo {
  init() {
    print ("init");
    return;
    print ("nope");
  }
}

var foo = Foo(); // expect: init
print (foo); // expect: Foo instance
