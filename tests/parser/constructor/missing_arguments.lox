// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:   class Foo {
// CHECK-PARSER-NEXT:    fun init(a: Number, b: Number)
// CHECK-PARSER-NEXT:    {
// CHECK-PARSER:         var foo = Foo(1);

// CHECK-SEMANTIC:        Error: No matching function overload found for call

class Foo {
  init(a: Number, b: Number) {}
}

var foo = Foo(1); // expect runtime error: Expected 2 arguments but got 1.
