// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:   class Foo {
// CHECK-PARSER-NEXT:     fun init()
// CHECK-PARSER-NEXT:     {
// CHECK-PARSER-NEXT:       fun init()
// CHECK-PARSER-NEXT:       {
// CHECK-PARSER-NEXT:         return "bar";
// CHECK-PARSER-NEXT:       }
// CHECK-PARSER-NEXT:       print(init());
// CHECK-PARSER-NEXT:     }
// CHECK-PARSER-NEXT:   }
// CHECK-PARSER-NEXT:   print(Foo());

// CHECK-SEMANTIC-LABEL:   class Foo {
// CHECK-SEMANTIC-NEXT:     fun init()
// CHECK-SEMANTIC-NEXT:     {
// CHECK-SEMANTIC-NEXT:       fun init()
// CHECK-SEMANTIC-NEXT:       {
// CHECK-SEMANTIC-NEXT:         return "bar";
// CHECK-SEMANTIC-NEXT:       }
// CHECK-SEMANTIC-NEXT:       print(init());
// CHECK-SEMANTIC-NEXT:     }
// CHECK-SEMANTIC-NEXT:   }
// CHECK-SEMANTIC-NEXT:   print(Foo());


class Foo {
  init() {
    fun init() {
      return "bar";
    }
    print (init()); // expect: bar
  }
}

print (Foo()); // expect: Foo instance
