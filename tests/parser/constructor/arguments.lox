// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:         class Foo {
// CHECK-PARSER-NEXT:      var b;
// CHECK-PARSER-NEXT:      var a;
// CHECK-PARSER-NEXT:      fun init(a: Number, b: Number)
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:           print("init");
// CHECK-PARSER-NEXT:           this.a = a;
// CHECK-PARSER-NEXT:           this.b = b;
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER-NEXT:     }
// CHECK-PARSER-NEXT:     var foo = Foo(1, 2);
// CHECK-PARSER-NEXT:     print(foo.a);
// CHECK-PARSER-NEXT:     print(foo.b);

// CHECK-SEMANTIC:         class Foo {
// CHECK-SEMANTIC-NEXT:      var b: Number;
// CHECK-SEMANTIC-NEXT:      var a: Number;
// CHECK-SEMANTIC-NEXT:      fun init(a: Number, b: Number)
// CHECK-SEMANTIC-NEXT:      {
// CHECK-SEMANTIC-NEXT:           print("init");
// CHECK-SEMANTIC-NEXT:           this.a = a;
// CHECK-SEMANTIC-NEXT:           this.b = b;
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC-NEXT:     }
// CHECK-SEMANTIC-NEXT:     var foo: Instance of Foo = Foo(1, 2);
// CHECK-SEMANTIC-NEXT:     print(foo.a);
// CHECK-SEMANTIC-NEXT:     print(foo.b);


class Foo {
  var a;
  var b;
  init(a: Number, b: Number) {
    print ("init"); // expect: init
    this.a = a;
    this.b = b;
  }
}

var foo = Foo(1, 2);
print (foo.a); // expect: 1
print (foo.b); // expect: 2
