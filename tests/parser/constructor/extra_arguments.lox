// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:         class Foo {
// CHECK-PARSER:           var b;
// CHECK-PARSER:           var a;
// CHECK-PARSER-NEXT:      fun init(a: Number, b: Number)
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:          this.a = a;
// CHECK-PARSER-NEXT:          this.b = b;
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER:         }
// CHECK-PARSER:         var foo = Foo(1, 2, 3, 4);

// CHECK-SEMANTIC:       Error: No matching function overload found for call
// CHECK-SEMANTIC:       class Foo {
// CHECK-SEMANTIC:         var b: Number;
// CHECK-SEMANTIC-NEXT:    var a: Number;
// CHECK-SEMANTIC-NEXT:    fun init(a: Number, b: Number)
// CHECK-SEMANTIC-NEXT:    {
// CHECK-SEMANTIC-NEXT:      this.a = a;
// CHECK-SEMANTIC-NEXT:      this.b = b;
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC:       }
// CHECK-SEMANTIC:       var foo = Foo(1, 2, 3, 4);

class Foo {
  var a;
  var b;
  init(a: Number, b: Number) {
    this.a = a;
    this.b = b;
  }
}

var foo = Foo(1, 2, 3, 4); // expect runtime error: Expected 2 arguments but got 4.
