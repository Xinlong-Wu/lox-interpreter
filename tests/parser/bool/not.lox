// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:     print(!true);
// CHECK-PARSER-NEXT:      print(!false);
// CHECK-PARSER-NEXT:      print(!!true);

// CHECK-SEMANTIC-LABEL:    print(!true);
// CHECK-SEMANTIC-NEXT:     print(!false);
// CHECK-SEMANTIC-NEXT:     print(!!true);

print (!true);    // expect: false
print (!false);   // expect: true
print (!!true);   // expect: true
