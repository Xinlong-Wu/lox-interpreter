// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:      var a = "outer";
// CHECK-PARSER-NEXT:       {
// CHECK-PARSER-NEXT:         var a = "inner";
// CHECK-PARSER-NEXT:         print(a);
// CHECK-PARSER-LABEL:      }
// CHECK-PARSER:            print(a);

// CHECK-SEMANTIC-LABEL:    var a: String = "outer";
// CHECK-SEMANTIC-NEXT:     {
// CHECK-SEMANTIC-NEXT:       var a: String = "inner";
// CHECK-SEMANTIC-NEXT:       print(a);
// CHECK-SEMANTIC-LABEL:    }
// CHECK-SEMANTIC:         print(a);


var a = "outer";

{
  var a = "inner";
  print (a); // expect: inner
}

print (a); // expect: outer
