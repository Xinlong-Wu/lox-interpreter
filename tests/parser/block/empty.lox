// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:     {
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER-LABEL:     if (true)
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER-LABEL:     if (false)
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:      } else {
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER-LABEL:     print("ok");

// CHECK-SEMANTIC-LABEL:     {
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC-LABEL:     if (true)
// CHECK-SEMANTIC-NEXT:      {
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC-LABEL:     if (false)
// CHECK-SEMANTIC-NEXT:      {
// CHECK-SEMANTIC-NEXT:      } else {
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC-LABEL:     print("ok");

{} // By itself.

// In a statement.
if (true) {}
if (false) {} else {}

print ("ok"); // expect: ok
