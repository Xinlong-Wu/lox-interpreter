// RUN: not %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:     Error: Invalid assignment target. Unable to assign to non-lvalue expression. at `=`, before: `"value"`
// CHECK-PARSER-NEXT:      var a = "a";
// CHECK-PARSER-NEXT:      !a;

// CHECK-SEMANTIC-LABEL:   Error: Invalid assignment target. Unable to assign to non-lvalue expression. at `=`, before: `"value"`
// CHECK-SEMANTIC-NEXT:    Error: Cannot unify different types: 'String' and 'Bool'
// CHECK-SEMANTIC-NEXT:    var a: String = "a";
// CHECK-SEMANTIC-NEXT:    !a;
var a = "a";
!a = "value";
