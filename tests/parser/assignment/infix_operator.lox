// RUN: not %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SA

// CHECK-PARSER-LABEL:     Error: Invalid assignment target. Unable to assign to non-lvalue expression. at `=`, before: `"value"`
// CHECK-PARSER-NEXT:      var a = "a";
// CHECK-PARSER-NEXT:      var b = "b";
// CHECK-PARSER-NEXT:      a + b;

// CHECK-SA-LABEL:          Error: Invalid assignment target. Unable to assign to non-lvalue expression. at `=`, before: `"value"
// CHECK-SA-NEXT:           var a: String = "a";
// CHECK-SA-NEXT:           var b: String = "b";
// CHECK-SA-NEXT:           a + b;

var a = "a";
var b = "b";
a + b = "value";
