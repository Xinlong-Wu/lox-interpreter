// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:   class Foo {
// CHECK-PARSER-NEXT:       fun other(a: Number)
// CHECK-PARSER-NEXT:       {
// CHECK-PARSER-NEXT:           print("other");
// CHECK-PARSER-NEXT:           print(a);
// CHECK-PARSER-NEXT:       }
// CHECK-PARSER-NEXT:       fun method(a: Number)
// CHECK-PARSER-NEXT:       {
// CHECK-PARSER-NEXT:           print("method");
// CHECK-PARSER-NEXT:           print(a);
// CHECK-PARSER-NEXT:       }
// CHECK-PARSER-NEXT:   }
// CHECK-PARSER-NEXT:   var foo = Foo();
// CHECK-PARSER-NEXT:   var method = foo.method;
// CHECK-PARSER-NEXT:   foo.method = foo.other;
// CHECK-PARSER-NEXT:   foo.method(1);
// CHECK-PARSER-NEXT:   method(2);

// CHECK-SEMANTIC-LABEL:   class Foo {
// CHECK-SEMANTIC-NEXT:       fun other(a: Number)
// CHECK-SEMANTIC-NEXT:       {
// CHECK-SEMANTIC-NEXT:           print("other");
// CHECK-SEMANTIC-NEXT:           print(a);
// CHECK-SEMANTIC-NEXT:       }
// CHECK-SEMANTIC-NEXT:       fun method(a: Number)
// CHECK-SEMANTIC-NEXT:       {
// CHECK-SEMANTIC-NEXT:           print("method");
// CHECK-SEMANTIC-NEXT:           print(a);
// CHECK-SEMANTIC-NEXT:       }
// CHECK-SEMANTIC-NEXT:   }
// CHECK-SEMANTIC-NEXT:   var foo: Instance of Foo = Foo();
// CHECK-SEMANTIC-NEXT:   var method: Function method with 1 overloads = foo.method;
// CHECK-SEMANTIC-NEXT:   foo.method = foo.other;
// CHECK-SEMANTIC-NEXT:   foo.method(1);
// CHECK-SEMANTIC-NEXT:   method(2);

// Bound methods have identity equality.
class Foo {
  fun method(a: Number) {
    print ("method");
    print (a);
  }
  fun other(a: Number) {
    print ("other");
    print (a);
  }
}

var foo = Foo();
var method = foo.method;

// Setting a property shadows the instance method.
foo.method = foo.other;

foo.method(1);
// expect: other
// expect: 1

// The old method handle still points to the original method.
method(2);
// expect: method
// expect: 2
