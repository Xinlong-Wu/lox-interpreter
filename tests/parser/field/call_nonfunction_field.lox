// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:   class Foo {
// CHECK-PARSER-NEXT:    }
// CHECK-PARSER:         var foo = Foo();
// CHECK-PARSER-NEXT:    foo.bar = "not fn";
// CHECK-PARSER-NEXT:    foo.bar();

// CHECK-SEMANTIC-LABEL:   Field 'bar' not found in 'Instance of Foo'
// CHECK-SEMANTIC-LABEL:   class Foo {
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC-NEXT:    var foo: Instance of Foo = Foo();
// CHECK-SEMANTIC-NEXT:    foo.bar = "not fn";
// CHECK-SEMANTIC-NEXT:    foo.bar();

class Foo {}

var foo = Foo();
foo.bar = "not fn";

foo.bar(); // expect runtime error: Can only call functions and classes.
