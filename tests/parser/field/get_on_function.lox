// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:            fun foo()
// CHECK-PARSER-NEXT:       {
// CHECK-PARSER-NEXT:       }
// CHECK-PARSER-NEXT:       foo.bar;

// CHECK-SEMANTIC:          Unable to infer access expression 'foo.bar
// CHECK-SEMANTIC-NEXT:     Error: Expression in statement has no type
// CHECK-SEMANTIC-NEXT:     fun foo()
// CHECK-SEMANTIC-NEXT:     {
// CHECK-SEMANTIC-NEXT:     }
// CHECK-SEMANTIC-NEXT:       foo.bar;

fun foo() {}

foo.bar; // expect runtime error: Only instances have properties.
