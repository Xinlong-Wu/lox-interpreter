// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:    class Foo {
// CHECK-PARSER-NEXT:           var b: Number;
// CHECK-PARSER-NEXT:           var a: Number;
// CHECK-PARSER-NEXT:           fun bar(a: Number, b: Number)
// CHECK-PARSER-NEXT:           {
// CHECK-PARSER-NEXT:              print("bar");
// CHECK-PARSER-NEXT:              print(a);
// CHECK-PARSER-NEXT:              print(b);
// CHECK-PARSER-NEXT:           }
// CHECK-PARSER-NEXT:       }
// CHECK-PARSER-NEXT:       var foo = Foo();
// CHECK-PARSER-NEXT:       foo.bar(1, 2);

// CHECK-SEMANTIC-LABEL:    class Foo {
// CHECK-SEMANTIC-NEXT:           var b: Number;
// CHECK-SEMANTIC-NEXT:           var a: Number;
// CHECK-SEMANTIC-NEXT:           fun bar(a: Number, b: Number)
// CHECK-SEMANTIC-NEXT:           {
// CHECK-SEMANTIC-NEXT:              print("bar");
// CHECK-SEMANTIC-NEXT:              print(a);
// CHECK-SEMANTIC-NEXT:              print(b);
// CHECK-SEMANTIC-NEXT:           }
// CHECK-SEMANTIC-NEXT:       }
// CHECK-SEMANTIC-NEXT:       var foo: Instance of Foo = Foo();
// CHECK-SEMANTIC-NEXT:       foo.bar(1, 2);

class Foo {
  var a: Number;
  var b: Number;
  fun bar(a: Number, b: Number) {
    print ("bar");
    print (a);
    print (b);
  }
}

var foo = Foo();

foo.bar(1, 2);
