// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:        123.foo;

// CHECK-SEMANTIC:        Unable to infer access expression '123.foo
// CHECK-SEMANTIC-NEXT:   Error: Expression in statement has no type
// CHECK-SEMANTIC-NEXT:   123.foo;
123.foo; // expect runtime error: Only instances have properties.
