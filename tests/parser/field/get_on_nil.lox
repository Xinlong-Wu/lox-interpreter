// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:     nil.foo;

// CHECK-SEMANTIC:    Unable to infer access expression 'nil.foo
nil.foo; // expect runtime error: Only instances have properties.
