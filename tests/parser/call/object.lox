// RUN: %parser %s 2>&1 | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: not %parser --semantic-analyzer %s 2>&1 | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER-LABEL:     class Foo {
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER:           var foo = Foo();
// CHECK-PARSER-NEXT:      foo();

// CHECK-SEMANTIC-LABEL:   Unable call instance of class 'Foo' as a function
// CHECK-SEMANTIC-LABEL:   class Foo {
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC-NEXT:    var foo: Foo = Foo();
// CHECK-SEMANTIC-NEXT:    foo();

class Foo {}
var foo = Foo();
foo(); // expect runtime error: Can only call functions and classes.
