// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// This is a regression test. When closing upvalues for discarded locals, it
// wouldn't make sure it discarded the upvalue for the correct stack slot.
//
// Here we create two locals that can be closed over, but only the first one
// actually is. When "b" goes out of scope, we need to make sure we don't
// prematurely close "a".

// CHECK-PARSER:           var closure;
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:        var a = "a";
// CHECK-PARSER-NEXT:        {
// CHECK-PARSER-NEXT:          var b = "b";
// CHECK-PARSER-NEXT:          fun returnA()
// CHECK-PARSER-NEXT:          {
// CHECK-PARSER-NEXT:             return a;
// CHECK-PARSER-NEXT:          }
// CHECK-PARSER:               closure = returnA;
// CHECK-PARSER-NEXT:          if (false)
// CHECK-PARSER-NEXT:          {
// CHECK-PARSER-NEXT:            fun returnB()
// CHECK-PARSER-NEXT:            {
// CHECK-PARSER-NEXT:               return b;
// CHECK-PARSER-NEXT:            }
// CHECK-PARSER-NEXT:          }
// CHECK-PARSER-NEXT:        }
// CHECK-PARSER-NEXT:        print(closure());
// CHECK-PARSER-NEXT:      }

// CHECK-SEMANTIC:            var closure: Function returnA with 1 overloads;
// CHECK-SEMANTIC-NEXT:       {
// CHECK-SEMANTIC-NEXT:         var a: String = "a";
// CHECK-SEMANTIC-NEXT:         {
// CHECK-SEMANTIC-NEXT:           var b: String = "b";
// CHECK-SEMANTIC-NEXT:           fun returnA()
// CHECK-SEMANTIC-NEXT:           {
// CHECK-SEMANTIC-NEXT:              return a;
// CHECK-SEMANTIC-NEXT:           }
// CHECK-SEMANTIC:                closure = returnA;
// CHECK-SEMANTIC-NEXT:         if (false)
// CHECK-SEMANTIC-NEXT:         {
// CHECK-SEMANTIC-NEXT:           fun returnB()
// CHECK-SEMANTIC-NEXT:           {
// CHECK-SEMANTIC-NEXT:              return b;
// CHECK-SEMANTIC-NEXT:           }
// CHECK-SEMANTIC-NEXT:         }
// CHECK-SEMANTIC-NEXT:       }
// CHECK-SEMANTIC-NEXT:       print(closure());
// CHECK-SEMANTIC-NEXT:     }

var closure;

{
  var a = "a";

  {
    var b = "b";
    fun returnA() {
      return a;
    }

    closure = returnA;

    if (false) {
      fun returnB() {
        return b;
      }
    }
  }

  print (closure()); // expect: a
}
