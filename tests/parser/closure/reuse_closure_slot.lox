// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:         {
// CHECK-PARSER-NEXT:      var f;
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:        var a = "a";
// CHECK-PARSER-NEXT:        fun f_()
// CHECK-PARSER-NEXT:        {
// CHECK-PARSER-NEXT:           print(a);
// CHECK-PARSER-NEXT:        }
// CHECK-PARSER:             f = f_;
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER:           {
// CHECK-PARSER-NEXT:        var b = "b";
// CHECK-PARSER-NEXT:        f();
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER:         }

// CHECK-SEMANTIC:         {
// CHECK-SEMANTIC-NEXT:      var f: Function f_ with 1 overloads;
// CHECK-SEMANTIC-NEXT:      {
// CHECK-SEMANTIC-NEXT:        var a: String = "a";
// CHECK-SEMANTIC-NEXT:        fun f_()
// CHECK-SEMANTIC-NEXT:        {
// CHECK-SEMANTIC-NEXT:          print(a);
// CHECK-SEMANTIC-NEXT:        }
// CHECK-SEMANTIC:             f = f_;
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC:           {
// CHECK-SEMANTIC-NEXT:        var b: String = "b";
// CHECK-SEMANTIC-NEXT:        f();
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC:         }

{
  var f;

  {
    var a = "a";
    fun f_() { print (a); }
    f = f_;
  }

  {
    // Since a is out of scope, the local slot will be reused by b. Make sure
    // that f still closes over a.
    var b = "b";
    f(); // expect: a
  }
}
