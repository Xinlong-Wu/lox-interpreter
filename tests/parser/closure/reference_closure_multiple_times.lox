// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// CHECK-PARSER:              var f;
// CHECK-PARSER-NEXT:         {
// CHECK-PARSER-NEXT:           var a = "a";
// CHECK-PARSER-NEXT:           fun f_()
// CHECK-PARSER-NEXT:           {
// CHECK-PARSER-NEXT:              print(a);
// CHECK-PARSER-NEXT:              print(a);
// CHECK-PARSER-NEXT:           }
// CHECK-PARSER:                f = f_;
// CHECK-PARSER-NEXT:         }
// CHECK-PARSER:              f();

// CHECK-SEMANTIC:          var f: Function f_ with 1 overloads;
// CHECK-SEMANTIC-NEXT:     {
// CHECK-SEMANTIC-NEXT:       var a: String = "a";
// CHECK-SEMANTIC-NEXT:       fun f_()
// CHECK-SEMANTIC-NEXT:       {
// CHECK-SEMANTIC-NEXT:         print(a);
// CHECK-SEMANTIC-NEXT:         print(a);
// CHECK-SEMANTIC-NEXT:       }
// CHECK-SEMANTIC:            f = f_;
// CHECK-SEMANTIC-NEXT:     }
// CHECK-SEMANTIC:          f();

var f;

{
  var a = "a";
  fun f_() {
    print (a);
    print (a);
  }
  f = f_;
}

f();
