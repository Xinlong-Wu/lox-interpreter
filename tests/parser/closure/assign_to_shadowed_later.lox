// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC


// CHECK-PARSER:         var a = "global";
// CHECK-PARSER-NEXT:    {
// CHECK-PARSER-NEXT:      fun assign()
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:        a = "assigned";
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER:           var a = "inner";
// CHECK-PARSER-NEXT:      assign();
// CHECK-PARSER-NEXT:      print(a);
// CHECK-PARSER-NEXT:    }
// CHECK-PARSER:         print(a);

// CHECK-SEMANTIC:			  var a: String = "global";
// CHECK-SEMANTIC-NEXT:		{
// CHECK-SEMANTIC-NEXT:			fun assign()
// CHECK-SEMANTIC-NEXT:			{
// CHECK-SEMANTIC-NEXT:				a = "assigned";
// CHECK-SEMANTIC-NEXT:			}
// CHECK-SEMANTIC:				  var a: String = "inner";
// CHECK-SEMANTIC-NEXT:			assign();
// CHECK-SEMANTIC-NEXT:			print(a);
// CHECK-SEMANTIC-NEXT:		}
// CHECK-SEMANTIC:			  print(a);

var a = "global";

{
  fun assign() {
    a = "assigned";
  }

  var a = "inner";
  assign();

  print (a);
}

print (a);
