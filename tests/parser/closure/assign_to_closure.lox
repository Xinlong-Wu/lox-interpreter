// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC


// CHECK-PARSER:           var f;
// CHECK-PARSER-NEXT:      var g;
// CHECK-PARSER-NEXT:      {
// CHECK-PARSER-NEXT:        var local = "local";
// CHECK-PARSER-NEXT:        fun f_()
// CHECK-PARSER-NEXT:        {
// CHECK-PARSER-NEXT:          print(local);
// CHECK-PARSER-NEXT:          local = "after f";
// CHECK-PARSER-NEXT:          print(local);
// CHECK-PARSER-NEXT:        }

// CHECK-PARSER:             f = f_;
// CHECK-PARSER-NEXT:        fun g_()
// CHECK-PARSER-NEXT:        {
// CHECK-PARSER-NEXT:          print(local);
// CHECK-PARSER-NEXT:          local = "after g";
// CHECK-PARSER-NEXT:          print(local);
// CHECK-PARSER-NEXT:        }

// CHECK-PARSER:             g = g_;
// CHECK-PARSER-NEXT:      }

// CHECK-PARSER:           f();
// CHECK-PARSER-NEXT:      g();


// CHECK-SEMANTIC:			var f: Function f_ with 1 overloads;
// CHECK-SEMANTIC:			var g: Function g_ with 1 overloads;
// CHECK-SEMANTIC:			{
// CHECK-SEMANTIC-NEXT:			var local: String = "local";
// CHECK-SEMANTIC-NEXT:    	fun f_()
// CHECK-SEMANTIC-NEXT:			{
// CHECK-SEMANTIC-NEXT:				print(local);
// CHECK-SEMANTIC-NEXT:				local = "after f";
// CHECK-SEMANTIC-NEXT:				print(local);
// CHECK-SEMANTIC-NEXT:			}
// CHECK-SEMANTIC:				  f = f_;
// CHECK-SEMANTIC-NEXT:			fun g_()
// CHECK-SEMANTIC-NEXT:			{
// CHECK-SEMANTIC-NEXT:				print(local);
// CHECK-SEMANTIC-NEXT:				local = "after g";
// CHECK-SEMANTIC-NEXT:				print(local);
// CHECK-SEMANTIC-NEXT:			}
// CHECK-SEMANTIC:				  g = g_;
// CHECK-SEMANTIC-NEXT:		}
// CHECK-SEMANTIC:			  f();
// CHECK-SEMANTIC-NEXT:		g();


var f;
var g;

{
  var local = "local";
  fun f_() {
    print (local);
    local = "after f";
    print (local);
  }
  f = f_;

  fun g_() {
    print (local);
    local = "after g";
    print (local);
  }
  g = g_;
}

f();

g();
