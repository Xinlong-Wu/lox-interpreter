// RUN: %parser %s | FileCheck %s --check-prefix=CHECK-PARSER
// RUN: %parser --semantic-analyzer %s | FileCheck %s --check-prefix=CHECK-SEMANTIC

// This is a regression test. There was a bug where the VM would try to close
// an upvalue even if the upvalue was never created because the codepath for
// the closure was not executed.

// CHECK-PARSER:           {
// CHECK-PARSER-NEXT:        var a = "a";
// CHECK-PARSER-NEXT:        if (false)
// CHECK-PARSER-NEXT:        {
// CHECK-PARSER-NEXT:          fun foo()
// CHECK-PARSER-NEXT:          {
// CHECK-PARSER-NEXT:             a;
// CHECK-PARSER-NEXT:          }
// CHECK-PARSER-NEXT:        }
// CHECK-PARSER-NEXT:      }
// CHECK-PARSER-NEXT:      print("ok");

// CHECK-SEMANTIC:         {
// CHECK-SEMANTIC-NEXT:      var a: String = "a";
// CHECK-SEMANTIC-NEXT:      if (false)
// CHECK-SEMANTIC-NEXT:      {
// CHECK-SEMANTIC-NEXT:        fun foo()
// CHECK-SEMANTIC-NEXT:        {
// CHECK-SEMANTIC-NEXT:           a;
// CHECK-SEMANTIC-NEXT:        }
// CHECK-SEMANTIC-NEXT:      }
// CHECK-SEMANTIC-NEXT:    }
// CHECK-SEMANTIC-NEXT:    print("ok");


{
  var a = "a";
  if (false) {
    fun foo() { a; }
  }
}

// If we get here, we didn't segfault when a went out of scope.
print ("ok"); // expect: ok
